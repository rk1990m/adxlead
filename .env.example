# ============================================================================
# Adxlead Growth OS — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your credentials. NEVER commit .env!
# ============================================================================

# 1. Server Runtime
HOST=127.0.0.1
PORT=8780
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-64-char-random-hex-secret

# 2. Database & Cache (Phase 1 Multi-Tenant PostgreSQL + Phase 5 Redis Queue)
DATABASE_URL=postgresql://adxlead_user:change_password@localhost:5432/adxlead_prod
REDIS_URL=redis://localhost:6379/0

# 3. Google Search Console & Indexing API v3
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json
GSC_SERVICE_ACCOUNT_EMAIL=gsc-indexer@your-gcp-project.iam.gserviceaccount.com

# 4. 1-Click Google OAuth 2.0 (Phase 2 — GSC + Google Ads Customer Connect)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8780/api/auth/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token

# 5. Third-Party Live SERP & Keyword Spy APIs (Phase 3 — Competitor Intelligence)
SERPER_API_KEY=your-serper-dev-api-key
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password

# 6. AI Copy Copilot (Phase 6 — Click-Magnet SERP & RSA Generation)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# 7. Subscription Billing & Webhooks (Phase 4 — Monetization)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 8. Multi-Channel Alert Dispatchers (Phase 5 — Watchdog & Rank Drop Alerts)
RESEND_API_KEY=re_your_resend_api_key
ALERT_FROM_EMAIL=alerts@adxlead.com
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
SLACK_DEFAULT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
